    "runs": {
      "TABLE": {
        "stdout": "PUT file://{DATA}/f*.csv @~/{STAGE}/\n+---------------------------------------------------------------------------------------------------------------+\n| source | target    | source_size | target_size | source_compression | target_compression | status   | message |\n|--------+-----------+-------------+-------------+--------------------+--------------------+----------+---------|\n| f1.csv | f1.csv.gz | 8           | 48          | NONE               | GZIP               | UPLOADED |         |\n| f2.csv | f2.csv.gz | 2           | 32          | NONE               | GZIP               | UPLOADED |         |\n+---------------------------------------------------------------------------------------------------------------+\n",
        "stderr": "",
        "exit": 0
